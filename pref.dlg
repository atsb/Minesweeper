ID_DLG_PREF DIALOGEX 0, 0, 120, 80
STYLE DS_MODALFRAME | WS_POPUP | WS_DLGFRAME
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "OK", ID_BTN_OK, 80, 30, 30, 14
    LTEXT "Custom Field", ID_TXT_CUST, 30, 10, 70, 8
    LTEXT "&Height:", ID_TXT_HEIGHT, 10, 32, 25, 10
    EDITTEXT ID_EDIT_HEIGHT, 40, 30, 25, 12, ES_LEFT | WS_BORDER | WS_TABSTOP
    LTEXT "&Width:", ID_TXT_WIDTH, 10, 47, 25, 10
    EDITTEXT ID_EDIT_WIDTH, 40, 45, 25, 12, ES_LEFT | WS_BORDER | WS_TABSTOP
    LTEXT "&Mines:", ID_TXT_MINES, 10, 62, 25, 10
    EDITTEXT ID_EDIT_MINES, 40, 60, 25, 12, ES_LEFT | WS_BORDER | WS_TABSTOP
END

ID_DLG_ENTER DIALOGEX 0, 28, 100, 100
STYLE DS_MODALFRAME | WS_POPUP | WS_DLGFRAME
FONT 8, "MS Shell Dlg"
BEGIN
    EDITTEXT ID_EDIT_NAME, 12, 51, 78, 12, ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON "OK", ID_BTN_OK, 32, 71, 36, 16
    CTEXT "", ID_TEXT_BEST, 4, 4, 88, 43
END

ID_DLG_BEST DIALOGEX 0, 28, 170, 85
STYLE DS_MODALFRAME | WS_POPUP | WS_DLGFRAME
CAPTION "Fastest Mine Sweepers"
FONT 8, "MS Shell Dlg"
BEGIN
    DEFPUSHBUTTON "OK", ID_BTN_OK, 115, 65, 30, 12
    PUSHBUTTON "&Reset Scores", ID_BTN_RESET, 25, 65, 50, 12
    LTEXT "Fastest Mine Sweepers", -1, 44, 10, 80, 8
    LTEXT "Beginner:", -1, 10, 25, 48, 8
    LTEXT "", ID_TIME_BEGIN, 60, 25, 44, 8
    LTEXT "", ID_NAME_BEGIN, 115, 25, 60, 8
    LTEXT "Intermediate:", -1, 10, 35, 48, 8
    LTEXT "", ID_TIME_INTER, 60, 35, 44, 8
    LTEXT "", ID_NAME_INTER, 115, 35, 60, 8
    LTEXT "Expert:", -1, 10, 45, 48, 8
    LTEXT "", ID_TIME_EXPERT, 60, 45, 44, 8
    LTEXT "", ID_NAME_EXPERT, 115, 45, 60, 8
END
